    "version": "0.2.0",
    "configurations": [
        {
            "name": "Down PDBs",
            "type": "python",
            "request": "launch",
            "program": "download_pdbs.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": ["--json", "data/j3_3.83.json",
                    "--output_dir", "pdbs",
                    "--skip_existing"]
        },
        {
            "name": "CSVs",
            "type": "python",
            "request": "launch",
            "program": "download_pdbs.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": ["--json", "data/j3_3.83.json",
                    "--csv_only",
                    "--output_dir", "pdbs_csv",
                    ]
        },
        {
            "name": "RNAqua",
            "type": "python",
            "request": "launch",
            "program": "process_for_RNAqua.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": ["--directory", "pdbs_csv/",
                    "--output_dir", "J3_pdbs",
                    ]
        },
        {
            "name": "Download cifs from atlas",
            "type": "python",
            "request": "launch",
            "program": "download_cifs_from_atlas.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--json=data/il_3.83.json",
                "--output_dir=il_cifs",
                "--centroid-only"
                    ]
        },
        {
            "name": "Convert cifs to pdb",
            "type": "python",
            "request": "launch",
            "program": "convert_cifs_to_pdbs.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--input_dir=j3_cifs",
                "--output_dir=j3_pdbs",
                    ]
        },
        {
            "name": "Run Current file",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}